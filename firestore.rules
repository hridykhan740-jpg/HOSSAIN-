rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
             'email' in request.auth.token &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'hridykhan740@gmail.com';
    }

    // Validation Helpers
    function isValidVisitor(data) {
      return data.keys().hasAll(['email', 'visitedAt']) && data.keys().size() == 2 &&
             data.email is string && data.email.size() <= 256 && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.visitedAt == request.time;
    }

    function isValidService(data) {
      return data.keys().hasAll(['title', 'description', 'createdAt']) &&
             data.title is string && data.title.size() <= 128 &&
             data.description is string && data.description.size() <= 1000;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['url', 'createdAt']) &&
             data.url is string && data.url.size() <= 2048;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['reviewerName', 'rating', 'content', 'createdAt']) &&
             data.reviewerName is string && data.reviewerName.size() <= 128 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.content is string && data.content.size() <= 1000;
    }

    // Collections

    match /profile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /visitors/{visitorId} {
      allow create: if isValidId(visitorId) && isValidVisitor(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true; 
      allow create: if isAdmin() && isValidId(serviceId);
      allow update: if isAdmin() && isValidId(serviceId);
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(galleryId);
      allow update: if isValidId(galleryId) && (
        isAdmin() || 
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['comments']))
      );
      allow delete: if isAdmin() && isValidId(galleryId);
    }

    match /portfolio/{portId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(portId);
    }

    match /orders/{orderId} {
      allow create: if isValidId(orderId);
      allow read, update, delete: if isAdmin() && isValidId(orderId);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId);
      allow update: if isAdmin() && isValidId(reviewId);
      allow delete: if isAdmin() && isValidId(reviewId);
    }
  }
}

